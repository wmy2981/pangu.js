  "ai_spacing_description": {
    "message": "$code_open$+$code_close$、$code_open$-$code_close$ 等符号在不同语境下含义不同（例如“第 3-5 页”与“3-5=2”），静态规则无法可靠判断。开启后由浏览器内置模型判断符号两侧是否需要空格。",
    "description": "",
    "placeholders": {
      "code_open": {
        "content": "<code>"
      },
      "code_close": {
        "content": "</code>"
      }
    }
  },
  "ai_spacing_tooltip": {
    "message": "+、- 等符号在不同语境下含义不同（例如“第 3-5 页”与“3-5=2”），静态规则无法可靠判断。开启后由浏览器内置模型判断符号两侧是否需要空格。",
    "description": ""
  },
